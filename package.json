{
  "name": "envoy",
  "version": "0.1.7",
  "description": "Sync a vault with a GitLab repository without Git, on desktop and mobile. Works with Enclave: notes are only ever uploaded locked.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src tests",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "keywords": [
    "obsidian",
    "gitlab",
    "sync"
  ],
  "author": "Florian Wolf",
  "contributors": [
    "Alexander Terekhin",
    "Silvano Cerza"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "obsidian": "^1.11.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.60",
    "ignore": "^7.0.6"
  },
  "packageManager": "pnpm@10.14.0"
}
